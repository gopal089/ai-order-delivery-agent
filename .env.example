# Spring Boot runtime defaults for local development.
SPRING_PROFILES_ACTIVE=local
SPRING_APPLICATION_NAME=backend
SERVER_PORT=8080
LOG_LEVEL_ROOT=INFO
SHUTDOWN_TIMEOUT=20s

# Local PostgreSQL development infrastructure.
# Copy this file to .env and replace the password.
POSTGRES_DB=order_delivery_dev
POSTGRES_USER=order_delivery_dev
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Spring Boot PostgreSQL connection.
# Keep DATABASE_PASSWORD equal to POSTGRES_PASSWORD for local development.
# Use host "postgres" instead of "localhost" if the backend later runs in Compose.
DATABASE_URL=jdbc:postgresql://localhost:5432/order_delivery_dev
DATABASE_USERNAME=order_delivery_dev
DATABASE_PASSWORD=replace-with-the-same-local-development-password

# Base64-encoded random value of at least 32 bytes. Generate locally; never commit the real value.
AUTH_ACCESS_TOKEN_SIGNING_KEY=replace-with-base64-encoded-random-value

# Exact browser origins allowed to call the backend in local development.
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001

# Redis authentication-abuse protection. Leave REDIS_PASSWORD empty for the local Compose service.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

# Development rate-limit defaults. Durations use ISO-8601 format.
AUTH_RATE_LIMIT_NAMESPACE=auth:ratelimit
AUTH_RATE_LIMIT_LOGIN_IDENTITY_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_LOGIN_IDENTITY_WINDOW=PT15M
AUTH_RATE_LIMIT_LOGIN_IP_MAX_ATTEMPTS=60
AUTH_RATE_LIMIT_LOGIN_IP_WINDOW=PT1M
AUTH_RATE_LIMIT_REFRESH_SESSION_MAX_ATTEMPTS=30
AUTH_RATE_LIMIT_REFRESH_SESSION_WINDOW=PT1M
AUTH_RATE_LIMIT_REFRESH_IP_MAX_ATTEMPTS=120
AUTH_RATE_LIMIT_REFRESH_IP_WINDOW=PT1M

# Structured console output. Supported Spring Boot formats include logstash, ecs, and gelf.
LOG_STRUCTURED_FORMAT=logstash
